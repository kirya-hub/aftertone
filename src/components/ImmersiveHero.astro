---
import { Picture } from 'astro:assets';
import fallback from '../assets/hero/neon-resonance.png';
---

<section class="immersive-hero" aria-labelledby="immersive-title" data-immersive-hero>
  <div class="immersive-frame">
    <div class="scene-kicker micro">
      <span>
        <i aria-hidden="true"></i>A SHARED SPACE FOR SPATIAL SOUND
      </span>
      <span>
        SPATIAL STUDIES <b>/</b> 001
      </span>
    </div>
    <div class="resonator-stage" data-renderer="fallback" aria-hidden="true">
      <div class="stage-atmosphere"></div>
      <div class="resonator-fallback">
        <Picture
          src={fallback}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 800, 1254]}
          sizes="(max-width: 700px) 100vw, 660px"
          alt=""
          loading="eager"
          fetchpriority="high"
          quality={85}
        />
      </div>
      <canvas class="resonator-canvas" data-resonator></canvas>
      <div class="stage-ground"></div>
    </div>
    <aside class="scene-aside scene-aside-left">
      <span class="micro">01 / LISTEN BEYOND THE FRAME</span>
      <p>
        One space.
        <br />
        Every perspective.
      </p>
      <span class="axis-mark" aria-hidden="true">
        ＋<span> X &nbsp; Y &nbsp; Z</span>
      </span>
    </aside>
    <aside class="scene-aside scene-aside-right">
      <span class="micro">SOUND, GIVEN FORM.</span>
      <p>
        For sound designers.
        <br />
        World builders.
        <br />
        Anyone who hears
        <br />
        things differently.
      </p>
      <span class="wave-mark" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </span>
    </aside>
    <div class="immersive-content">
      <h1 id="immersive-title">
        <span>Give sound</span>
        <br />
        <em>a sense of place.</em>
      </h1>
      <p class="immersive-description">
        Shape the sound. Share the space.
        <br class="small-break" /> Find your next dimension, together.
      </p>
      <a class="immersive-cta" href="#demo">
        Explore the playground <span aria-hidden="true">↗</span>
      </a>
      <p class="immersive-note micro">AN INTERACTIVE CONCEPT. MADE TO BE EXPLORED.</p>
    </div>
    <div class="immersive-footer micro">
      <a href="#approach">
        STEP INSIDE THE SOUND <span aria-hidden="true">↓</span>
      </a>
      <span>
        CREATE <b>·</b> PLACE <b>·</b> COLLABORATE
      </span>
      <span>LESS TIMELINE. MORE POSSIBILITY.</span>
    </div>
  </div>
</section>

<script>
  import { mountImmersiveHero } from '../scripts/immersive-hero';
  let dispose = mountImmersiveHero();
  const hide = () => dispose();
  const show = (event: PageTransitionEvent) => {
    if (event.persisted) dispose = mountImmersiveHero();
  };
  window.addEventListener('pagehide', hide);
  window.addEventListener('pageshow', show);
  if (import.meta.hot)
    import.meta.hot.dispose(() => {
      dispose();
      window.removeEventListener('pagehide', hide);
      window.removeEventListener('pageshow', show);
    });
</script>

<style>
  .immersive-hero {
    --im-bg: #080910;
    --im-text: #f5f1fa;
    --im-muted: #b9b4ca;
    --im-action: #e7ddff;
    --im-on-action: #201431;
    --im-cyan: #95edee;
    --im-violet: #a794ff;
    --im-magenta: #df64b9;
    color: var(--im-text);
    background: var(--im-bg);
    isolation: isolate;
    overflow: clip;
    position: relative;
  }
  .immersive-frame {
    position: relative;
    width: calc(100% - var(--gutter) * 2);
    max-width: 1536px;
    margin: auto;
    min-height: max(796px, calc(100svh - 104px));
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .micro {
    font: 400 9px/1.6 var(--mono);
    letter-spacing: 0.07em;
    color: var(--im-muted);
  }
  .scene-kicker {
    align-self: stretch;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    z-index: 1;
  }
  .scene-kicker > span:first-child {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .scene-kicker i {
    width: 5px;
    height: 5px;
    background: var(--im-cyan);
    border-radius: 50%;
    box-shadow: 0 0 12px #95edee55;
  }
  .micro b {
    color: var(--im-violet);
    font-weight: 400;
    padding-inline: 8px;
  }
  .resonator-stage {
    position: absolute;
    top: 12px;
    width: min(880px, 80vw);
    height: 420px;
  }
  .resonator-canvas {
    pointer-events: none;
    inset: 0;
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .resonator-stage[data-renderer='webgl'] .resonator-canvas {
    opacity: 1;
  }
  .stage-atmosphere {
    position: absolute;
    inset: -10% -12% -4%;
    background:
      radial-gradient(ellipse at 44% 40%, #643cd426, transparent 55%),
      radial-gradient(ellipse at 66% 52%, #b8308120, transparent 43%),
      radial-gradient(ellipse at 24% 63%, #25677912, transparent 40%);
  }
  .resonator-fallback {
    position: absolute;
    inset: -28px 15%;
    mask-image: radial-gradient(ellipse, #000 29%, transparent 72%);
  }
  .resonator-fallback :global(picture),
  .resonator-fallback :global(img) {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: contain;
  }
  .stage-ground {
    position: absolute;
    bottom: 3%;
    left: 22%;
    width: 56%;
    height: 17px;
    border-radius: 50%;
    background: radial-gradient(ellipse, #a56ce52a, transparent 70%);
    filter: blur(8px);
  }
  .scene-aside {
    position: absolute;
    top: 205px;
    max-width: 205px;
  }
  .scene-aside-left {
    left: 0;
  }
  .scene-aside-right {
    right: 0;
    text-align: right;
  }
  .scene-aside .micro {
    font-size: 8px;
  }
  .scene-aside p {
    margin-top: 17px;
    font-size: 13px;
    line-height: 1.75;
    color: #d2cbdf;
  }
  .axis-mark {
    display: block;
    margin-top: 26px;
    font: 24px var(--mono);
    color: var(--im-violet);
  }
  .axis-mark span {
    font-size: 8px;
    color: var(--im-muted);
    vertical-align: middle;
    margin-left: 13px;
  }
  .wave-mark {
    margin-top: 24px;
    display: flex;
    height: 22px;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
  }
  .wave-mark i {
    display: block;
    width: 1px;
    height: 6px;
    background: var(--im-magenta);
  }
  .wave-mark i:nth-child(2n) {
    height: 13px;
  }
  .wave-mark i:nth-child(3n) {
    height: 21px;
  }
  .immersive-content {
    margin-top: auto;
    padding-top: 326px;
    padding-bottom: 30px;
    text-align: center;
    position: relative;
  }
  h1 {
    font-size: clamp(65px, 6.1vw, 99px);
    font-weight: 550;
    line-height: 0.99;
    letter-spacing: -0.065em;
    margin: 0;
  }
  h1 em {
    color: #ded1fa;
    font-weight: 400;
    letter-spacing: -0.063em;
  }
  .immersive-description {
    margin-top: 23px;
    color: var(--im-muted);
    font-size: 14px;
    line-height: 1.8;
    letter-spacing: -0.02em;
  }
  .small-break {
    display: none;
  }
  .immersive-cta {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    min-width: 250px;
    min-height: 52px;
    margin-top: 23px;
    padding: 0 23px;
    border: 1px solid #f0e9ff;
    border-radius: 40px;
    color: var(--im-on-action);
    background: var(--im-action);
    box-shadow:
      0 0 26px #a794ff14,
      inset 0 1px 0 #fff;
    font-size: 13px;
    font-weight: 650;
    transition:
      background 0.2s,
      box-shadow 0.2s;
  }
  .immersive-cta span {
    font-size: 23px;
    font-weight: 400;
  }
  .immersive-cta:hover {
    background: #f4efff;
    box-shadow: 0 0 30px #a794ff30;
  }
  .immersive-cta:active {
    background: #d0c0f2;
  }
  a:focus-visible {
    outline: 2px solid var(--im-cyan);
    outline-offset: 5px;
  }
  .immersive-note {
    margin-top: 14px;
    font-size: 8px;
    letter-spacing: 0.035em;
  }
  .immersive-footer {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-top: 1px solid #b9b4ca29;
    min-height: 64px;
    margin-top: auto;
    font-size: 8px;
  }
  .immersive-footer a {
    color: var(--im-text);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 22px;
  }
  .immersive-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  :global(body:has(.immersive-hero) .header) {
    background: #080910;
    color: #f5f1fa;
    border-color: #b9b4ca29;
  }
  :global(body:has(.immersive-hero) .header)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #080910;
    box-shadow: 0 0 0 100vmax #080910;
    clip-path: inset(0 -100vmax);
  }
  :global(body:has(.immersive-hero) .brand svg) {
    color: #bbadf5;
  }
  :global(body:has(.immersive-hero) .header-cta) {
    border-color: #b9b4ca;
    border-radius: 40px;
  }
  :global(body:has(.immersive-hero) .header-cta:hover) {
    background: #e7ddff;
    color: #201431;
  }
  :global(body:has(.immersive-hero) .desktop-nav a:hover) {
    color: #95edee;
  }
  :global(body:has(.immersive-hero) .header a:focus-visible),
  :global(body:has(.immersive-hero) .header summary:focus-visible) {
    outline-color: #95edee;
  }
  :global(body:has(.immersive-hero) .mobile-nav nav) {
    background: #171422;
    color: #f5f1fa;
    border-color: #b9b4ca;
  }
  @media (max-width: 1100px) {
    .scene-aside {
      max-width: 150px;
    }
    .scene-aside .micro {
      font-size: 7px;
    }
    .scene-aside p {
      font-size: 12px;
    }
    .resonator-stage {
      width: 75vw;
    }
    .immersive-footer > span:last-child {
      display: none;
    }
  }
  @media (max-width: 850px) {
    .scene-aside {
      display: none;
    }
    .resonator-stage {
      width: 100vw;
    }
  }
  @media (max-width: 700px) {
    .immersive-frame {
      min-height: max(720px, calc(100svh - 80px));
    }
    .scene-kicker {
      padding-top: 23px;
      justify-content: center;
      font-size: 8px;
      letter-spacing: 0.035em;
    }
    .scene-kicker > span:last-child {
      display: none;
    }
    .resonator-stage {
      top: 44px;
      height: 300px;
      width: 115vw;
    }
    .resonator-fallback {
      inset: -16px 8%;
    }
    .stage-ground {
      bottom: 3%;
    }
    .immersive-content {
      margin-top: auto;
      padding-top: 300px;
      padding-bottom: 25px;
      width: 100%;
    }
    h1 {
      font-size: clamp(43px, 10.5vw, 68px);
      line-height: 1.07;
    }
    h1 em {
      white-space: nowrap;
    }
    .immersive-description {
      margin-top: 20px;
      font-size: 12px;
      line-height: 1.8;
    }
    .small-break {
      display: block;
    }
    .immersive-cta {
      margin-top: 22px;
      min-height: 52px;
    }
    .immersive-note {
      font-size: 7px;
      margin-top: 15px;
    }
    .immersive-footer {
      min-height: 56px;
      justify-content: center;
      font-size: 8px;
    }
    .immersive-footer > span {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .immersive-cta {
      transition: none;
    }
  }
</style>
