---
interface Props { variant?: 'hero' | 'story'; }
const { variant = 'hero' } = Astro.props;
// A projected acoustic shell: each contour is a cross-section of the same field.
const contours = Array.from({ length: 38 }, (_, i) => {
  const t = i / 37;
  const radius = 70 + 205 * Math.sin(t * Math.PI * .87);
  const cy = 164 + t * 247;
  const ry = radius * .34;
  return `M ${360-radius} ${cy} a ${radius} ${ry} 0 1 0 ${radius*2} 0 a ${radius} ${ry} 0 1 0 ${-radius*2} 0`;
});
---
<svg class:list={['spatial-field', `field-${variant}`]} viewBox="0 0 720 590" fill="none" role="img" aria-label="A three-dimensional sound field: three sources surround a central listening position, with curved contours showing depth and distance.">
  <defs>
    <linearGradient id={`field-stroke-${variant}`} x1="80" y1="420" x2="560" y2="150" gradientUnits="userSpaceOnUse"><stop stop-color="#54808b" stop-opacity=".16"/><stop offset=".5" stop-color="#BFE8EF" stop-opacity=".8"/><stop offset="1" stop-color="#BFE8EF" stop-opacity=".22"/></linearGradient>
    <radialGradient id={`field-floor-${variant}`}><stop stop-color="#BFE8EF" stop-opacity=".045"/><stop offset="1" stop-color="#BFE8EF" stop-opacity="0"/></radialGradient>
  </defs>
  <g class="field-base">
    <ellipse cx="360" cy="423" rx="335" ry="117" fill={`url(#field-floor-${variant})`}/>
    {[1,2,3,4].map(i=><ellipse cx="360" cy="423" rx={i*78} ry={i*29} stroke="#BFE8EF" stroke-opacity=".09" stroke-dasharray={i===4 ? '2 7' : undefined}/>)}
    <path d="M37 423H683M360 298v251M93 336l534 174M93 510l534-174" stroke="#BFE8EF" stroke-opacity=".1"/>
  </g>
  <g class="field-shell" stroke={`url(#field-stroke-${variant})`} stroke-width=".8">
    {contours.map((d,i)=><path class="contour" d={d} style={`--contour-index:${i}`}/>)}
  </g>
  <g class="field-connections" stroke-width="1" stroke-dasharray="3 5"><path d="M360 423L205 302M360 423l179-163M360 423V124" stroke="#BFE8EF" stroke-opacity=".42"/></g>
  <g class="field-source source-air"><path d="M205 302v121" stroke="#BFE8EF" stroke-opacity=".3"/><ellipse cx="205" cy="423" rx="17" ry="5" stroke="#BFE8EF" stroke-opacity=".3"/><circle cx="205" cy="302" r="17" fill="#141820" stroke="#BFE8EF" stroke-opacity=".5"/><circle cx="205" cy="302" r="5" fill="#BFE8EF"/><text x="114" y="280" fill="#BFE8EF">01 / ATMOSPHERE</text></g>
  <g class="field-source source-voice"><path d="M539 260v163" stroke="#BFE8EF" stroke-opacity=".3"/><ellipse cx="539" cy="423" rx="17" ry="5" stroke="#BFE8EF" stroke-opacity=".3"/><circle cx="539" cy="260" r="17" fill="#141820" stroke="#BFE8EF" stroke-opacity=".5"/><circle cx="539" cy="260" r="5" fill="#BFE8EF"/><text x="557" y="237" fill="#BFE8EF">02 / VOICE</text></g>
  <g class="field-source source-signal"><path d="M360 124v299" stroke="#F08C75" stroke-opacity=".4"/><circle cx="360" cy="124" r="23" stroke="#F08C75" stroke-opacity=".2"/><circle cx="360" cy="124" r="12" fill="#141820" stroke="#F08C75"/><circle cx="360" cy="124" r="4" fill="#F08C75"/><text x="385" y="106" fill="#F08C75">03 / SIGNAL</text></g>
  <g class="field-listener"><circle cx="360" cy="423" r="14" fill="#141820" stroke="#F1EEE7"/><path d="m355 426 5-9 5 9" stroke="#F1EEE7" stroke-width="1.3"/><text x="360" y="468" text-anchor="middle" fill="#9BA8B1">LISTENING POSITION</text></g>
  <path class="field-orbit" d="M117 430C71 304 243 180 442 220S671 430 570 461" stroke="#F08C75" stroke-opacity=".65" stroke-dasharray="3 6"/>
</svg>
