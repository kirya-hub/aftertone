---
const sources = [{id:'air',name:'Atmosphere',tag:'01',x:29,y:36,color:'cyan'},{id:'voice',name:'Voice',tag:'02',x:71,y:42,color:'cream'},{id:'signal',name:'Signal',tag:'03',x:58,y:70,color:'coral'}];
---
<section id="demo" class="demo-section wrap" aria-labelledby="demo-title">
  <div class="section-kicker mono"><span>03 / LESS WATCHING. MORE EXPLORING.</span><span>THE INTERACTIVE PLAYGROUND</span></div>
  <div class="demo-intro"><h2 id="demo-title" data-reveal>A little shift.<br /><em>A different feeling.</em></h2><p>Move a source. Change your perspective.<br />Explore the visual relationships that<br class="desktop-break" /> make a scene feel like a place.</p></div>
  <div class="playground" data-demo>
    <div class="playground-toolbar"><span class="mono"><i class="status-dot"></i> UNTITLED SCENE / EXPLORATION 01</span><span class="prototype-badge mono">VISUAL DEMO</span></div>
    <div class="playground-body">
      <div class="demo-field-area"><div class="axis-label mono">FRONT</div><div class="demo-field" aria-label="Top-down spatial scene">
        <svg class="demo-grid" viewBox="0 0 600 440" preserveAspectRatio="none" fill="none" aria-hidden="true"><g stroke="#BFE8EF" stroke-opacity=".12">{[45,90,135,180].map(r=><circle cx="300" cy="220" r={r}/>)}<path d="M0 220h600M300 0v440"/><path d="M0 0l600 440M600 0 0 440" stroke-dasharray="2 6"/></g><g class="demo-lines" stroke-dasharray="3 6" stroke-opacity=".45">{sources.map(s=><line data-line={s.id} x1="300" y1="220" x2={s.x*6} y2={s.y*4.4} stroke={s.color==='coral'?'#F08C75':'#BFE8EF'}/>)}</g></svg>
        <span class="direction direction-left mono">L</span><span class="direction direction-right mono">R</span><span class="demo-listener"><svg viewBox="0 0 30 30" aria-hidden="true"><path d="m8 21 7-15 7 15-7-4Z" fill="none" stroke="currentColor" stroke-width="1.3"/></svg><span class="mono">YOU</span></span>
        {sources.map((s,i)=><button type="button" class:list={['sound-source',`source-${s.color}`]} data-source={s.id} aria-pressed={i===0?'true':'false'} aria-label={`Select ${s.name}`} disabled style={`left:${s.x}%;top:${s.y}%`}><span class="source-halo"></span><span class="source-core">{s.tag}</span><span class="source-label">{s.name}</span></button>)}
      </div><div class="demo-field-bottom mono"><span>TOP VIEW / PLANAR PLACEMENT</span><span>BACK</span><span>NOT TO SCALE</span></div></div>
      <aside class="source-inspector"><span class="mono inspector-eyebrow">SOURCE / <span data-source-number>01</span></span><h3 data-source-name>Atmosphere</h3><p data-source-description>A wide environmental bed. A little distance gives the scene room to breathe.</p><div class="source-position"><span class="mono">POSITION IN THE FIELD</span><strong data-position-description>Front left</strong></div><fieldset disabled data-position-controls><legend class="sr-only">Source position</legend><label for="position-x"><span>LEFT / RIGHT</span><output id="output-x" for="position-x">−42</output></label><input type="range" id="position-x" min="10" max="90" value="29" step="1" aria-describedby="demo-instructions"/><label for="position-y"><span>FRONT / BACK</span><output id="output-y" for="position-y">−28</output></label><input type="range" id="position-y" min="10" max="90" value="36" step="1" aria-describedby="demo-instructions"/></fieldset><button class="reset-scene" type="button" disabled>Reset the scene <span aria-hidden="true">↺</span></button><p class="demo-instructions" id="demo-instructions">Select a source, then drag it or use the position sliders. On a source, use arrow keys to move; Shift for bigger steps.</p></aside>
    </div>
    <div class="playground-bottom"><span><span aria-hidden="true">↔</span> A SMALL SPACE FOR A BIG IDEA.</span><span>Visual placement only. No audio is generated or processed.</span></div>
    <p class="sr-only" data-demo-announcement role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
  <noscript><p class="noscript-note">This is the initial scene. Enable JavaScript to select and reposition sources. All product information and navigation remain available.</p></noscript>
</section>
