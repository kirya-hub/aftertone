---
import { Picture } from 'astro:assets';
import sculpture from '../assets/hero/refined-resonance.png';
import editorial from '../assets/hero/experimental-resonator.png';

interface Props {
  direction: 'refined-spatial' | 'immersive-experience' | 'experimental-editorial';
}
const { direction } = Astro.props;
---

<section
  class:list={['direction-hero', direction]}
  data-direction={direction}
  aria-labelledby="direction-title"
>
  {direction === 'refined-spatial' && (
    <div class="refined-layout">
      <div class="refined-kicker utility">
        <span>A SHARED SPACE FOR SPATIAL SOUND</span>
        <span>AFTERTONE / FIELD NOTES 001</span>
      </div>
      <h1 id="direction-title">
        Give sound
        <br />
        <em>a sense of place.</em>
      </h1>
      <div class="refined-lower">
        <div class="refined-copy">
          <p class="description">
            Shape the sound. Share the space.
            <br />
            Find your next dimension, together.
          </p>
          <a class="direction-cta" href="#demo">
            Explore the playground <span aria-hidden="true">↗</span>
          </a>
          <p class="concept utility">AN INTERACTIVE CONCEPT. MADE TO BE EXPLORED.</p>
        </div>
        <figure class="spatial-specimen">
          <svg viewBox="0 0 620 350" role="img" aria-labelledby="field-title field-desc">
            <title id="field-title">One space. Every perspective.</title>
            <desc id="field-desc">
              Three sound sources surround a listener in a shared spatial field.
            </desc>
            <defs>
              <radialGradient id="field-shadow">
                <stop stop-color="#263e3624" />
                <stop offset="1" stop-color="#263e3600" />
              </radialGradient>
              <linearGradient id="field-wire" x2="0.8" y2="1">
                <stop stop-color="#8a9b8a" />
                <stop offset="0.5" stop-color="#365749" />
                <stop offset="1" stop-color="#a1aa97" />
              </linearGradient>
              <radialGradient id="field-core" cx="0.32" cy="0.25">
                <stop stop-color="#e8eee0" />
                <stop offset="0.45" stop-color="#819782" />
                <stop offset="1" stop-color="#234a3e" />
              </radialGradient>
            </defs>
            <ellipse cx="310" cy="287" rx="247" ry="47" fill="url(#field-shadow)" />
            <g fill="none" stroke="url(#field-wire)" stroke-width="1.1">
              <ellipse cx="310" cy="178" rx="228" ry="103" transform="rotate(-12 310 178)" />
              <ellipse cx="310" cy="178" rx="176" ry="78" transform="rotate(-12 310 178)" />
              <ellipse cx="310" cy="178" rx="121" ry="52" transform="rotate(-12 310 178)" />
              <ellipse cx="310" cy="178" rx="102" ry="140" transform="rotate(38 310 178)" />
              <ellipse cx="310" cy="178" rx="62" ry="140" transform="rotate(38 310 178)" />
              <path d="M98 218 487 100M173 70l270 218" stroke-dasharray="3 7" />
            </g>
            <path
              d="m164 126 147 52 143 31M311 178l-8-93"
              fill="none"
              stroke="#577668"
              stroke-dasharray="3 5"
            />
            <circle cx="311" cy="178" r="27" fill="url(#field-core)" />
            <g fill="#355c4c" stroke="#eeeae2" stroke-width="4">
              <circle cx="164" cy="126" r="8" />
              <circle cx="454" cy="209" r="8" />
              <circle cx="303" cy="85" r="8" />
            </g>
            <g fill="#48584f" font-family="'IBM Plex Mono',monospace" font-size="11">
              <text x="111" y="108">
                01 / VOICE
              </text>
              <text x="460" y="235">
                02 / AIR
              </text>
              <text x="315" y="73">
                03 / SIGNAL
              </text>
            </g>
          </svg>
          <figcaption class="utility">
            <span>ONE SPACE. EVERY PERSPECTIVE.</span>
            <span>CREATE · PLACE · COLLABORATE</span>
          </figcaption>
        </figure>
        <div class="refined-aside">
          <span class="specimen-index">01—∞</span>
          <p>
            For sound designers.
            <br />
            World builders.
            <br />
            Anyone who hears
            <br />
            things differently.
          </p>
          <span class="utility">SOUND, GIVEN FORM.</span>
        </div>
      </div>
      <div class="direction-footer utility">
        <a href="#approach">
          STEP INSIDE THE SOUND <span aria-hidden="true">↓</span>
        </a>
        <span>LESS TIMELINE. MORE POSSIBILITY.</span>
      </div>
    </div>
  )}

  {direction === 'immersive-experience' && (
    <div class="immersive-layout">
      <div class="immersive-kicker utility">
        <span>A SHARED SPACE FOR SPATIAL SOUND</span>
        <span>RESONANCE / 001</span>
      </div>
      <div class="cinema-stage" aria-hidden="true">
        <div class="cinema-orbit"></div>
        <div class="cinema-object">
          <Picture
            src={sculpture}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 800, 1254]}
            sizes="(max-width: 600px) 110vw, 720px"
            alt=""
            loading="eager"
            decoding="async"
            fetchpriority="high"
            quality={85}
            class="direction-image"
          />
        </div>
      </div>
      <div class="cinema-side cinema-side-left">
        <span class="utility">01 / LISTEN BEYOND THE FRAME</span>
        <p>
          One space.
          <br />
          Every perspective.
        </p>
      </div>
      <div class="cinema-side cinema-side-right">
        <span class="utility">SOUND, GIVEN FORM.</span>
        <p>
          For sound designers.
          <br />
          World builders.
          <br />
          Anyone who hears
          <br />
          things differently.
        </p>
      </div>
      <div class="immersive-copy">
        <h1 id="direction-title">
          Give sound
          <br />
          <em>a sense of place.</em>
        </h1>
        <p class="description">
          Shape the sound. Share the space.
          <br class="mobile-break" /> Find your next dimension, together.
        </p>
        <a class="direction-cta" href="#demo">
          Explore the playground <span aria-hidden="true">↗</span>
        </a>
        <p class="concept utility">AN INTERACTIVE CONCEPT. MADE TO BE EXPLORED.</p>
      </div>
      <div class="direction-footer utility">
        <a href="#approach">
          STEP INSIDE THE SOUND <span aria-hidden="true">↓</span>
        </a>
        <span>CREATE · PLACE · COLLABORATE</span>
        <span>LESS TIMELINE. MORE POSSIBILITY.</span>
      </div>
    </div>
  )}

  {direction === 'experimental-editorial' && (
    <div class="editorial-layout">
      <div class="editorial-kicker utility">
        <span>A SHARED SPACE FOR SPATIAL SOUND</span>
        <span>VOL. 001 — A NEW PERSPECTIVE</span>
      </div>
      <h1 id="direction-title" class="editorial-title">
        <span class="editorial-give">Give sound</span>
        <span class="editorial-sense">a sense of</span>
        <em class="editorial-place">place.</em>
      </h1>
      <figure class="editorial-art">
        <Picture
          src={editorial}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[360, 600, 800]}
          sizes="(max-width: 600px) 43vw, 32vw"
          alt="Sculptural glass layers intertwine around an open acoustic space."
          loading="eager"
          decoding="async"
          fetchpriority="high"
          quality={85}
          class="direction-image"
        />
        <figcaption class="utility">FIG. 01 / SOUND, GIVEN FORM.</figcaption>
      </figure>
      <span class="editorial-margin utility" aria-hidden="true">
        AFTERTONE — SPATIAL STUDIES — 001
      </span>
      <div class="editorial-copy">
        <p class="description">
          Shape the sound. Share the space.
          <br />
          Find your next dimension, together.
        </p>
        <p class="editorial-audience">
          For sound designers. World builders.
          <br />
          Anyone who hears things differently.
        </p>
      </div>
      <a class="editorial-action" href="#demo">
        <span>
          Explore the
          <br />
          playground
        </span>
        <span class="editorial-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
      <div class="editorial-caption">
        <p>
          One space.
          <br />
          Every perspective.
        </p>
        <span class="utility">CREATE · PLACE · COLLABORATE</span>
      </div>
      <div class="direction-footer utility">
        <a href="#approach">
          STEP INSIDE THE SOUND <span aria-hidden="true">↓</span>
        </a>
        <span>AN INTERACTIVE CONCEPT. MADE TO BE EXPLORED.</span>
        <span>LESS TIMELINE. MORE POSSIBILITY.</span>
      </div>
    </div>
  )}
</section>

<style>
  .direction-hero {
    --dir-bg: #eeeae2;
    --dir-surface: #e1dfd4;
    --dir-text: #202b26;
    --dir-muted: #546157;
    --dir-action: #294f40;
    --dir-on-action: #f5f3eb;
    --dir-focus: #294f40;
    color: var(--dir-text);
    background: var(--dir-bg);
    position: relative;
    overflow: clip;
    isolation: isolate;
  }
  .utility {
    font-family: var(--mono);
    font-size: 10px;
    line-height: 1.6;
    letter-spacing: 0.055em;
    font-weight: 400;
  }
  .direction-hero h1 {
    margin: 0;
    font-weight: 450;
    letter-spacing: -0.065em;
  }
  .direction-hero em {
    color: inherit;
  }
  .direction-hero figure {
    margin: 0;
  }
  .description {
    font-size: 15px;
    line-height: 1.8;
    letter-spacing: -0.02em;
  }
  .concept {
    color: var(--dir-muted);
    margin-top: 20px;
  }
  .direction-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-height: 52px;
    padding: 0 24px;
    background: var(--dir-action);
    color: var(--dir-on-action);
    font-size: 13px;
    font-weight: 600;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .direction-cta span {
    font-size: 22px;
  }
  .direction-cta:hover {
    background: color-mix(in srgb, var(--dir-action), var(--dir-text) 15%);
    transform: translateY(-2px);
  }
  .direction-cta:active {
    transform: translateY(0);
  }
  .direction-hero a:focus-visible {
    outline: 2px solid var(--dir-focus);
    outline-offset: 5px;
  }
  .direction-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 66px;
    border-top: 1px solid color-mix(in srgb, var(--dir-text) 22%, transparent);
    color: var(--dir-muted);
  }
  .direction-footer a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 18px;
    color: var(--dir-text);
  }
  .direction-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  :global(body:has(.direction-hero) .header) {
    color: #202b26;
    background: #eeeae2;
    border-color: #202b2633;
  }
  :global(body:has(.direction-hero) .header)::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #eeeae2;
    box-shadow: 0 0 0 100vmax #eeeae2;
    clip-path: inset(0 -100vmax);
    z-index: -1;
  }
  :global(body:has(.direction-hero) .header .brand svg) {
    color: #294f40;
  }
  :global(body:has(.direction-hero) .header-cta) {
    border-color: #546157;
    border-radius: 0;
  }
  :global(body:has(.direction-hero) .header-cta:hover) {
    background: #294f40;
    color: #f5f3eb;
  }
  :global(body:has(.direction-hero) .header a:focus-visible),
  :global(body:has(.direction-hero) .header summary:focus-visible) {
    outline-color: #294f40;
  }
  :global(body:has(.direction-hero) .mobile-nav nav) {
    background: #eeeae2;
    color: #202b26;
    border-color: #546157;
  }
  :global(body:has(.direction-hero) .mobile-nav summary span) {
    background: currentColor;
  }
  :global(body:has(.direction-hero) .desktop-nav a:hover) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  /* 01: a quiet, horizontal gallery. Type above; a shared field below. */
  .refined-layout {
    width: calc(100% - var(--gutter) * 2);
    max-width: 1536px;
    margin: auto;
    min-height: max(796px, calc(100svh - 104px));
    display: flex;
    flex-direction: column;
  }
  .refined-kicker {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-top: 30px;
    color: var(--dir-muted);
  }
  .refined-spatial h1 {
    text-align: center;
    font-size: clamp(60px, 6.4vw, 106px);
    line-height: 1.06;
    margin-top: 65px;
  }
  .refined-spatial h1 em {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.065em;
    padding-left: 90px;
  }
  .refined-lower {
    display: grid;
    grid-template-columns: 1fr 2fr 0.68fr;
    gap: 24px;
    align-items: center;
    margin-block: auto;
    padding: 20px 0 35px;
  }
  .refined-copy {
    align-self: center;
  }
  .refined-copy .direction-cta {
    margin-top: 25px;
    white-space: nowrap;
  }
  .spatial-specimen svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .spatial-specimen figcaption {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: var(--dir-muted);
    padding-inline: 15px;
    font-size: 9px;
  }
  .refined-aside {
    border-left: 1px solid #202b2633;
    padding-left: 25px;
  }
  .specimen-index {
    font-size: 32px;
    font-weight: 400;
    letter-spacing: -0.07em;
  }
  .refined-aside p {
    font-size: 12px;
    line-height: 1.8;
    margin: 25px 0;
  }
  .refined-aside > .utility {
    font-size: 9px;
    color: var(--dir-muted);
  }

  /* 02: axial, object-first cinema; copy sits beneath the sculptural focus. */
  .immersive-experience {
    --dir-bg: #09090e;
    --dir-surface: #20212a;
    --dir-text: #f1edf3;
    --dir-muted: #b2aebe;
    --dir-action: #d7e8df;
    --dir-on-action: #17271f;
    --dir-focus: #d7e8df;
  }
  .immersive-layout {
    position: relative;
    min-height: max(796px, calc(100svh - 104px));
    width: calc(100% - var(--gutter) * 2);
    max-width: 1536px;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .immersive-kicker {
    align-self: stretch;
    display: flex;
    justify-content: space-between;
    padding-top: 30px;
    color: var(--dir-muted);
    z-index: 2;
  }
  .cinema-stage {
    position: absolute;
    top: -45px;
    width: 740px;
    height: 600px;
    pointer-events: none;
    z-index: -1;
  }
  .cinema-object {
    width: 100%;
    height: 100%;
    mask-image: radial-gradient(ellipse at 50% 43%, #000 36%, transparent 70%);
    animation: enter-object 1.2s cubic-bezier(0.2, 0.6, 0.2, 1) both;
  }
  .cinema-object picture {
    width: 100%;
    height: 100%;
    display: block;
  }
  .cinema-object .direction-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .cinema-orbit {
    position: absolute;
    inset: 15% -19%;
    border: 1px solid #b2aebe2b;
    border-radius: 50%;
    transform: rotate(-17deg) scaleY(0.65);
    z-index: -1;
  }
  .cinema-side {
    position: absolute;
    top: 255px;
    max-width: 205px;
  }
  .cinema-side-left {
    left: 0;
  }
  .cinema-side-right {
    right: 0;
    text-align: right;
  }
  .cinema-side .utility {
    font-size: 9px;
    color: var(--dir-muted);
  }
  .cinema-side p {
    font-size: 14px;
    line-height: 1.6;
    margin-top: 16px;
  }
  .immersive-copy {
    margin-top: auto;
    padding-top: 220px;
    padding-bottom: 32px;
    text-align: center;
    z-index: 1;
  }
  .immersive-experience h1 {
    font-size: clamp(70px, 6.1vw, 100px);
    line-height: 1.03;
    font-weight: 600;
    text-shadow: 0 2px 30px #09090e;
  }
  .immersive-experience h1 em {
    font-weight: 400;
    letter-spacing: -0.06em;
  }
  .immersive-copy .description {
    margin-top: 19px;
    color: var(--dir-muted);
  }
  .immersive-copy .direction-cta {
    margin-top: 25px;
    border-radius: 50px;
    min-width: 245px;
  }
  .immersive-copy .concept {
    font-size: 9px;
    margin-top: 14px;
  }
  .immersive-layout > .direction-footer {
    align-self: stretch;
    margin-top: auto;
  }
  .mobile-break {
    display: none;
  }
  :global(body:has(.immersive-experience) .header) {
    color: #f1edf3;
    background: #09090e;
    border-color: #b2aebe33;
  }
  :global(body:has(.immersive-experience) .header)::before {
    background: #09090e;
    box-shadow: 0 0 0 100vmax #09090e;
  }
  :global(body:has(.immersive-experience) .header .brand svg) {
    color: #d7e8df;
  }
  :global(body:has(.immersive-experience) .header-cta) {
    border-color: #b2aebe;
    border-radius: 50px;
  }
  :global(body:has(.immersive-experience) .header-cta:hover) {
    background: #d7e8df;
    color: #17271f;
  }
  :global(body:has(.immersive-experience) .header a:focus-visible),
  :global(body:has(.immersive-experience) .header summary:focus-visible) {
    outline-color: #d7e8df;
  }
  :global(body:has(.immersive-experience) .mobile-nav nav) {
    background: #20212a;
    color: #f1edf3;
    border-color: #b2aebe;
  }

  /* 03: an asymmetric editorial grid, not a copy/image split. */
  .experimental-editorial {
    --dir-bg: #e9e5d9;
    --dir-surface: #dcd8cc;
    --dir-text: #232723;
    --dir-muted: #545a51;
    --dir-action: #a52c20;
    --dir-on-action: #fff8ec;
    --dir-focus: #a52c20;
  }
  .editorial-layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 70px 155px 133px 190px 170px 78px;
    column-gap: 18px;
    width: calc(100% - var(--gutter) * 2);
    max-width: 1536px;
    min-height: calc(100svh - 104px);
    margin: auto;
    position: relative;
  }
  .editorial-kicker {
    grid-column: 1/-1;
    grid-row: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--dir-muted);
  }
  .editorial-title {
    display: contents;
  }
  .editorial-give {
    grid-column: 1/10;
    grid-row: 2;
    font-size: clamp(80px, 10.4vw, 164px);
    line-height: 0.9;
    letter-spacing: -0.085em;
    font-weight: 700;
    z-index: 2;
    white-space: nowrap;
    align-self: center;
  }
  .editorial-sense {
    grid-column: 2/8;
    grid-row: 3;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(66px, 7.2vw, 116px);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.95;
    align-self: center;
    z-index: 2;
  }
  .editorial-place {
    grid-column: 5/11;
    grid-row: 4;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(150px, 18vw, 280px);
    font-weight: 400;
    font-style: italic;
    color: var(--dir-action) !important;
    letter-spacing: -0.085em;
    line-height: 0.8;
    z-index: 2;
    align-self: center;
  }
  .editorial-art {
    grid-column: 9/-1;
    grid-row: 2/4;
    align-self: start;
    padding-top: 20px;
    transform: rotate(5deg);
    z-index: 1;
  }
  .editorial-art picture {
    display: block;
    height: 280px;
    background: #101512;
    overflow: hidden;
  }
  .editorial-art .direction-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .editorial-art figcaption {
    font-size: 9px;
    padding-top: 12px;
    color: var(--dir-muted);
  }
  .editorial-margin {
    position: absolute;
    right: -16px;
    top: 420px;
    writing-mode: vertical-rl;
    font-size: 9px;
  }
  .editorial-copy {
    grid-column: 1/5;
    grid-row: 4/6;
    align-self: center;
    border-top: 1px solid #23272344;
    padding-top: 26px;
  }
  .editorial-audience {
    font-size: 11px;
    line-height: 1.8;
    color: var(--dir-muted);
    margin-top: 22px;
  }
  .editorial-action {
    grid-column: 6/9;
    grid-row: 5;
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 17px;
    font-weight: 650;
    line-height: 1.3;
    align-self: center;
    min-height: 76px;
  }
  .editorial-arrow {
    width: 72px;
    height: 72px;
    border: 1px solid var(--dir-action);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 36px;
    color: var(--dir-action);
    transition:
      color 0.2s,
      background 0.2s;
    flex-shrink: 0;
  }
  .editorial-action:hover .editorial-arrow {
    background: var(--dir-action);
    color: var(--dir-on-action);
  }
  .editorial-caption {
    grid-column: 10/-1;
    grid-row: 5;
    align-self: center;
    border-left: 1px solid #23272344;
    padding-left: 20px;
  }
  .editorial-caption p {
    font-size: 17px;
    line-height: 1.4;
    letter-spacing: -0.035em;
  }
