---
import SpatialField from './SpatialField.astro';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-topline mono">
    <span>
      <i class="status-dot"></i> A SHARED SPACE FOR SPATIAL SOUND
    </span>
    <span class="hero-edition">INDEPENDENT BY DESIGN. IMMERSIVE BY NATURE.</span>
  </div>
  <div class="hero-body">
    <div class="hero-copy">
      <h1 id="hero-title">
        <span>Give sound</span>
        <span>a sense</span>
        <span>
          of&nbsp;<em>place.</em>
        </span>
      </h1>
      <p>
        Sound doesn’t live on a line.
        <br />
        Neither should the conversation.
      </p>
      <a class="button button-coral" href="#demo">
        Explore the playground <span aria-hidden="true">↗</span>
      </a>
      <span class="hero-note mono">A VISUAL PROTOTYPE. OPEN TO EXPLORATION.</span>
    </div>
    <div class="hero-art">
      <div class="field-heading mono">
        <span>FIELD 001 — THE LISTENING ROOM</span>
        <span class="cross">+</span>
      </div>
      <SpatialField />
      <div class="field-caption mono">
        <span>
          <i class="tiny-square"></i> EVERY SOUND HAS A SOMEWHERE.
        </span>
        <span>X / Y / Z</span>
      </div>
    </div>
  </div>
  <div class="hero-bottom">
    <a href="#approach" class="scroll-cue">
      <span aria-hidden="true">↓</span> SCROLL TO FIND YOUR PERSPECTIVE
    </a>
    <p>
      For sound designers, game worlds,
      <br />
      and stories you can step inside.
    </p>
    <span class="mono hero-coordinate">SPATIAL THINKING / HUMAN CONNECTION</span>
  </div>
</section>
