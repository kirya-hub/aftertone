---
import Brand from './Brand.astro';
interface Props {
  exhibition?: boolean;
}
const { exhibition = false } = Astro.props;
---

<header class="header wrap">
  <Brand />
  <nav class="desktop-nav" aria-label="Main navigation">
    <a href="#approach">{exhibition ? 'The trace' : 'The approach'}</a>
    <a href="#experience">{exhibition ? 'The chamber' : 'In space'}</a>
    <a href={exhibition ? '#common-ground' : '#capabilities'}>
      {exhibition ? 'Common ground' : 'Capabilities'}
    </a>
  </nav>
  <a class="header-cta" href="#demo">
    Enter the playground <span aria-hidden="true">↗</span>
  </a>
  <details class="mobile-nav">
    <summary aria-label="Toggle navigation">
      <span></span>
      <span></span>
    </summary>
    <nav aria-label="Mobile navigation">
      <a href="#approach">{exhibition ? 'The trace' : 'The approach'}</a>
      <a href="#experience">{exhibition ? 'The chamber' : 'In space'}</a>
      <a href="#demo">The playground ↗</a>
      <a href={exhibition ? '#common-ground' : '#capabilities'}>
        {exhibition ? 'Common ground' : 'Capabilities'}
      </a>
      <a href={exhibition ? '#afterglow' : '#faq'}>{exhibition ? 'Afterglow' : 'Questions'}</a>
    </nav>
  </details>
</header>
