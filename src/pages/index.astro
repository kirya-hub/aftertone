---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ImmersiveHero from '../components/ImmersiveHero.astro';
import Journey from '../components/exhibition/Journey.astro';
import '../styles/exhibition.css';
---

<Layout exhibition>
  <Header exhibition />
  <main id="main" tabindex="-1">
    <ImmersiveHero />
    <Journey />
  </main>
</Layout>
<script>
  import { initNavigation } from '../scripts/navigation';
  import { mountExhibition } from '../scripts/exhibition';
  let dispose = () => {};
  const mount = () => {
    dispose();
    const clean = [initNavigation(), mountExhibition()];
    dispose = () => clean.forEach((fn) => fn());
  };
  mount();
  const hide = () => dispose();
  const show = (e: PageTransitionEvent) => {
    if (e.persisted) mount();
  };
  window.addEventListener('pagehide', hide);
  window.addEventListener('pageshow', show);
  if (import.meta.hot)
    import.meta.hot.dispose(() => {
      hide();
      window.removeEventListener('pagehide', hide);
      window.removeEventListener('pageshow', show);
    });
</script>
