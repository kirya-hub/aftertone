{
  "name": "aftertone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --experimental-strip-types src/scripts/scene-state.test.ts && node --experimental-strip-types src/scripts/exhibition/state.test.ts && node --experimental-strip-types src/scripts/exhibition/scenes.test.ts",
    "test:browser": "node scripts/verify-exhibition.mjs",
    "measure": "node scripts/measure.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:exhibition": "node scripts/verify-exhibition.mjs",
    "test:legacy-browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.8",
    "gsap": "3.15.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
